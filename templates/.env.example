# image-gen 纯 env 模式示例（按需 export，或复制为 .env）

# 只填你实际拥有的渠道；缺失的渠道会在回退链里自动跳过。
# 推荐优先用 ~/.workbuddy/models.json（WorkBuddy 模型管理），已配置的 provider 会被自动发现。

# ---------- SiliconFlow ----------
# SILICONFLOW_API_KEY=sk-...
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=Qwen/Qwen-Image

# ---------- 阿里云百炼 ----------
# DASHSCOPE_API_KEY=sk-...
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# ---------- OpenAI / 任意 OpenAI 兼容 endpoint ----------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-image-1

# ---------- OpenRouter（国内需代理）----------
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_PROXY=http://127.0.0.1:7890

# ---------- 外挂风格包位置（可选）----------
# IMAGE_GEN_HANDRAW_PATH=/abs/path/to/handraw-style

# ---------- 内置出图开关（可选）----------
# IMAGE_GEN_BUILTIN_MODE=auto   # auto | first | last | off
